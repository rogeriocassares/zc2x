# Browsers connect unauthenticated to port 4223 and are validated via auth_callout
NATS_URL=nats://localhost:4222

# NATS Auth Callout credentials
# Generate keypair once with: cd apps/api && bun run scripts/generate-nats-account-key.ts
NATS_ACCOUNT_SEED=SAAIH2IDS6CGY4ZYFAXMX4BXTRU7IDPD6WBCWZ3O5KRRR7YQS5ZSTXQ6BM
NATS_ACCOUNT_PUBKEY=ABANMXISPBIM3UBWZGKPJNWC6E6D5MXQDCVRSN2KOEW46RFI4M7YYGLT
NATS_INTERNAL_PASSWORD=zc8-nats-dev-internal
NATS_WS_URL=ws://localhost:4223

# Same value as NATS_WS_URL above, under the name apps/web's browser bundle
# actually reads (src/lib/nats.ts). Has to be its own NEXT_PUBLIC_-prefixed
# var, not a rename of NATS_WS_URL: Next.js only inlines vars with that
# prefix into the client bundle, and only does so at build time -- see
# infra/docker/docker-compose.yaml's web service, which passes this as a
# Docker build arg, not a runtime environment variable.
NEXT_PUBLIC_NATS_URL=ws://localhost:4223

# InfluxDB 3 Core (infra/docker/docker-compose.yaml) — database/table used by
# services/output/influxdb3. Auth is enabled (docker-compose.yaml's
# --without-auth is commented out); INFLUXDB_TOKEN below is a real admin
# token bootstrapped with:
#   docker compose exec influxdb3-core influxdb3 create token --admin
# Used by both the output service and Grafana's datasource.
INFLUXDB_HOST=http://localhost:8181
INFLUXDB_DATABASE=zc2x
INFLUXDB_TABLE=telemetry
INFLUXDB_TOKEN=apiv3_7DCCchtszPNdYqNbDpSVJTAWu0hCw9t8FRxahUUgwCAeDw6P6aL92og1AdfpcijdOiMcl4sAF7ZSYeU7JdLLPw

# Grafana (infra/docker/docker-compose.yaml + infra/grafana/provisioning).
# These are Grafana's own native env var names (loaded verbatim via
# docker-compose's env_file:, not renamed), not an arbitrary project choice.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=zc2x-grafana-dev

# InfluxDB 3 Explorer (infra/docker/docker-compose.yaml). Also Explorer's own
# native env var name. MUST stay stable across restarts: Explorer encrypts
# its stored connection (from infra/influxdb3-explorer/config.json) in its
# SQLite session store (a persisted volume) using this key -- if unset, the
# image generates a *new random* key every container start, and the next
# restart then fails to decrypt data encrypted under the previous one
# ("error:1C800064:Provider routines::bad decrypt"). Set once here instead.
SESSION_SECRET_KEY=c1c181e11b3003526860aede5664c1152ba56c7f40fab5f8946e2c446b281f15